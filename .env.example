# Coinbase Developer Platform — portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Tavily free dev key — app.tavily.com (100 req/min, 1000 credits/mo)
TAVILY_API_KEY=

# Network
NETWORK=base-mainnet

# Constraints
MAX_AGENTS=5
MAX_QUERIES_PER_WORKER=2
MAX_SPEND_USDC=1.00

# Guardrails — spend
# Hard ceiling on what any single x402 call may charge (checked before signing)
MAX_PRICE_PER_CALL_USDC=0.05
# Process-wide daily cap across all runs (UTC day, in-memory)
MAX_DAILY_SPEND_USDC=10.00
# Timeout for search/x402 service calls
SERVICE_TIMEOUT_MS=20000

# Guardrails — requests
MAX_INTENT_CHARS=500
RATE_LIMIT_PER_HOUR=20
MAX_CONCURRENT_RUNS=3

# Guardrails — input screen (Claude classifier run before any search spend)
GUARDRAIL_SCREEN=true
GUARDRAIL_MODEL=claude-haiku-4-5
# false = block requests if the screen errors; true = let them through
GUARDRAIL_FAIL_OPEN=false

# Evals — model used as the LLM grader (npm run eval)
EVAL_JUDGE_MODEL=claude-opus-5-5

# Feature flags
# false = use free Tavily dev key (development); true = real x402 payments (demo)
USE_X402=false
# false = always use Tavily; true = discover services via x402 Bazaar (with Tavily fallback)
USE_DISCOVERY=false

# Server
PORT=3000
