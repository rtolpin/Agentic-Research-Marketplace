# Coinbase Developer Platform — portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Tavily free dev key — app.tavily.com (100 req/min, 1000 credits/mo)
TAVILY_API_KEY=

# Network
NETWORK=base-mainnet

# Constraints
MAX_AGENTS=5
MAX_SPEND_USDC=1.00

# Feature flags
# false = use free Tavily dev key (development); true = real x402 payments (demo)
USE_X402=false
# false = always use Tavily; true = discover services via x402 Bazaar (with Tavily fallback)
USE_DISCOVERY=false

# Server
PORT=3000
